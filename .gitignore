# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Real datasets (Master §2 rule 3 keeps synthetic data in tests/fixtures/; this is
# the opposite problem — real source extracts are large and are not ours to
# redistribute, so they live here and never enter git).
datasets/
data/raw/

# Local platform state (Track A runs write here; never committed)
.localstack/
data/bronze/
data/silver/
data/gold/
data/_snapshots/
mlruns/
*.db
*.sqlite3

# Reports produced by audit/reconciliation scripts (regenerate, don't commit)
reports/*.json
reports/*.html
# Generated demo recordings. Same rule as every other artifact under
# reports/: regenerate with `node frontend/scripts/record-demo.mjs`,
# never commit. A ten-megabyte binary that changes wholesale on every
# run is the worst possible thing to keep in git history.
reports/demo/
!reports/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
